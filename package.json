{
	"name": "spences10",
	"version": "3.0.3",
	"description": "My npm card",
	"keywords": [
		"business card",
		"card",
		"npm",
		"user details"
	],
	"homepage": "https://github.com/spences10/spences10#readme",
	"bugs": {
		"url": "https://github.com/spences10/spences10/issues"
	},
	"license": "MIT",
	"author": "Scott Spence <spences10apps@gmail.com> (https://scottspence.com)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spences10/spences10.git"
	},
	"bin": {
		"spences10": "./dist/index.js"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"main": "./dist/api.js",
	"types": "./dist/api.d.ts",
	"exports": {
		".": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js",
			"default": "./dist/api.js"
		}
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"start": "node ./dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp check --fix",
		"format:check": "vp check",
		"test": "pnpm run build && vp test",
		"test:watch": "vp test watch",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "git diff --quiet && git diff --cached --quiet && pnpm run build && changeset publish"
	},
	"dependencies": {
		"boxen": "^8.0.1",
		"chalk": "^6.0.0",
		"citty": "^0.2.2",
		"gradient-string": "^3.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.1",
		"@types/gradient-string": "^1.1.6",
		"@types/node": "^26.4.0",
		"typescript": "^7.0.2",
		"vite-plus": "^0.3.0",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.24.0"
}
